# 首次配置时，将本文件复制为 backend/.env，再在 .env 中填写自己的 API 密钥。

# 后端 HTTP 服务端口
PORT=3000

# Chroma 向量数据库地址和集合名称
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=enterprise_it_knowledge

# SiliconFlow API 密钥，用于生成向量和重排检索结果
SILICONFLOW_API_KEY=
# 向量生成接口的基础地址和模型名称
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
# 向量维度应与所选模型的输出维度一致
EMBEDDING_DIMENSION=1024
# 每批提交给向量生成接口的文本数量
EMBEDDING_BATCH_SIZE=16
# 用于给检索候选内容重新排序的模型
SILICONFLOW_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# DeepSeek API 密钥，用于生成问答回复
DEEPSEEK_API_KEY=
# DeepSeek 接口的基础地址和生成模型名称
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
